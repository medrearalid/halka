{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halka",
  "version": "0.1.3",
  "identifier": "app.halka.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' blob: mediastream:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Sunucusuz sesli sohbet",
    "longDescription": "Arkadaşlarınla sunucu olmadan, doğrudan ve uçtan uca şifreli konuş, yaz ve ekran paylaş.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi",
        "sidebarImage": "./windows/installer-hero.bmp",
        "installerIcon": "./icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NjUyQzYzNUIyRjhGOTUKUldTVmp5OWJZeXhsWlhRbXJ1M0RVak0wemY1LzRQUDlac1hUejhqdVdFd0ViaHNQN3F0R3I1eVgK",
      "endpoints": [
        "https://github.com/medrearalid/halka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
